<%# Avo the avocado and his guided tour. Turbo keeps the node across visits, so he walks from page to page instead
    of popping back in. He is the AI agent's mark (avo/ai/_pit_core_icon) with a face, arms and legs. %>
<%# His lines sit outside his node. Turbo keeps that one across visits, and this one is rendered anew on every page,
    so a stop can point at something the visitor made a moment ago. %>
<div id="tour-copy" hidden data-copy="<%= Tour.new.copy.to_json %>"></div>
<aside id="tour" class="tour" hidden data-turbo-permanent aria-label="Guided tour" data-controller="tour">
  <%# The page dimmed, with holes cut for what he points at and a ring around them. Each is drawn twice, in the mask
      and in the ring: the area, and the icon he opened it from, which juts out of it as one shape with it. %>
  <div class="tour__spotlight" data-tour-target="spotlight" hidden>
    <svg width="100%" height="100%" aria-hidden="true">
      <mask id="tour-holes" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
        <rect width="100%" height="100%" fill="#fff"/>
        <rect rx="10" data-tour-target="hole"/>
        <rect rx="10" data-tour-target="hole"/>
      </mask>
      <rect class="tour__dim" width="100%" height="100%" mask="url(#tour-holes)"/>
      <g class="tour__ring" mask="url(#tour-holes)">
        <rect rx="10" data-tour-target="hole"/>
        <rect rx="10" data-tour-target="hole"/>
      </g>
    </svg>
  </div>

  <div class="tour__guide" data-tour-target="guide" popover="manual">
    <button type="button" class="tour__mascot" data-tour-target="mascot" data-action="tour#greet" aria-label="Take the tour">
      <svg class="tour__avocado" viewBox="-2 0 28 25.5" fill="none" aria-hidden="true">
        <defs>
          <radialGradient id="tour-pit"><stop offset="0" stop-color="#FFD27A"/><stop offset=".6" stop-color="#E9A23B"/><stop offset="1" stop-color="#C98128"/></radialGradient>
          <radialGradient id="tour-glow"><stop offset="0" stop-color="#FFC861" stop-opacity=".8"/><stop offset="1" stop-color="#FFC861" stop-opacity="0"/></radialGradient>
          <%# A die-cut sticker's pale edge, so the dark skin and limbs read on a dark panel too. %>
          <filter id="tour-sticker" x="-25%" y="-25%" width="150%" height="150%">
            <feMorphology in="SourceAlpha" operator="dilate" radius=".5" result="edge"/>
            <feFlood flood-color="#FFFBF0"/>
            <feComposite in2="edge" operator="in"/>
            <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <path id="tour-pear" d="M12 2.5C9.6 2.5 8.4 4.6 7.6 7.2 7 9.1 4.5 10.6 4.5 14.6 4.5 18.8 7.8 21.5 12 21.5S19.5 18.8 19.5 14.6C19.5 10.6 17 9.1 16.4 7.2 15.6 4.6 14.4 2.5 12 2.5Z"/>
        </defs>

        <ellipse class="tour__shadow" cx="12" cy="24.6" rx="5" ry=".6"/>
        <g filter="url(#tour-sticker)">
          <path class="tour__limb" d="M10 20.5v3.3H8.8M14 20.5v3.3h1.2"/>
          <g class="tour__body">
            <%# Each arm is drawn pointing right from its shoulder; the controller turns it to rest or to point. %>
            <g class="tour__arm tour__arm--left" data-tour-target="leftArm">
              <path class="tour__limb" d="M5.6 13.4H10"/>
              <path class="tour__limb tour__finger" d="M10.4 13.4h1.5"/>
              <circle class="tour__hand" cx="10.4" cy="13.4" r="1.05"/>
            </g>
            <g class="tour__arm tour__arm--right" data-tour-target="rightArm">
              <path class="tour__limb" d="M18.4 13.4h4.4"/>
              <path class="tour__limb tour__finger" d="M23.2 13.4h1.5"/>
              <circle class="tour__hand" cx="23.2" cy="13.4" r="1.05"/>
            </g>

            <use href="#tour-pear" fill="#3F6B2E"/>
            <use href="#tour-pear" fill="#8DB85A" transform="translate(12 14.3) scale(.84) translate(-12 -14.3)"/>
            <use href="#tour-pear" fill="#C9DE8E" transform="translate(12 14.3) scale(.74) translate(-12 -14.3)"/>
            <circle cx="12" cy="15.4" r="5" fill="url(#tour-glow)"/>
            <circle cx="12" cy="15.4" r="3.2" fill="url(#tour-pit)"/>
            <ellipse cx="10.95" cy="14.25" rx="1" ry=".6" fill="#FFE3A3" transform="rotate(-30 10.95 14.25)"/>

            <ellipse class="tour__cheek" cx="9.4" cy="9.9" rx=".7" ry=".42"/>
            <ellipse class="tour__cheek" cx="14.6" cy="9.9" rx=".7" ry=".42"/>
            <g class="tour__eyes">
              <ellipse class="tour__ink" cx="10.3" cy="8.6" rx=".72" ry=".84"/>
              <ellipse class="tour__ink" cx="13.7" cy="8.6" rx=".72" ry=".84"/>
              <circle cx="10.55" cy="8.3" r=".24" fill="#fff"/>
              <circle cx="13.95" cy="8.3" r=".24" fill="#fff"/>
            </g>
            <path class="tour__smile" d="M11 10.1q1 1.1 2 0"/>
            <ellipse class="tour__ink tour__chatter" cx="12" cy="10.5" rx=".62" ry=".52"/>
          </g>
        </g>
      </svg>
    </button>

    <div class="tour__bubble" data-tour-target="bubble">
      <button type="button" class="tour__close" data-action="tour#end" aria-label="Close the tour">
        <%= svg "tabler/outline/x" %>
      </button>
      <button type="button" class="tour__close tour__mute" data-tour-target="mute" data-action="tour#mute"
              aria-label="Sound" aria-pressed="false" hidden>
        <span data-tour-target="voiceOn" hidden><%= svg "tabler/outline/volume" %></span>
        <span data-tour-target="voiceOff"><%= svg "tabler/outline/volume-off" %></span>
      </button>
      <p class="tour__text" data-tour-target="text" aria-live="polite"></p>

      <div class="tour__actions" data-tour-target="greeting" hidden>
        <%= a_button(style: :primary, color: :primary, size: :sm, type: :button, data: {action: "tour#start"}) { "Show me around" } %>
        <%= a_button(style: :outline, size: :sm, type: :button, data: {action: "tour#end"}) { "Not now" } %>
        <%= a_button(style: :text, size: :sm, type: :button, data: {action: "tour#never"}) { "Don't ask again" } %>
      </div>

      <div class="tour__actions" data-tour-target="sound" hidden>
        <%= a_button(style: :primary, color: :primary, size: :sm, type: :button, data: {action: "tour#withSound"}) { "With sound" } %>
        <%= a_button(style: :outline, size: :sm, type: :button, data: {action: "tour#withoutSound"}) { "Without sound" } %>
      </div>

      <div class="tour__actions" data-tour-target="nav" hidden>
        <span class="tour__counter" data-tour-target="counter"></span>
        <%# The arrow keys turn the stops too, and the two buttons say so. %>
        <%= a_button(style: :text, size: :sm, type: :button, data: {action: "tour#back", tour_target: "back"}, aria: {keyshortcuts: "ArrowLeft"}) do %>
          <kbd class="tour__key" aria-hidden="true"><%= svg "tabler/outline/arrow-left" %></kbd>Back
        <% end %>
        <%= a_button(style: :primary, color: :primary, size: :sm, type: :button, data: {action: "tour#next", tour_target: "next"}, aria: {keyshortcuts: "ArrowRight"}) do %>
          Next<kbd class="tour__key" aria-hidden="true"><%= svg "tabler/outline/arrow-right" %></kbd>
        <% end %>
        <%= a_button(style: :primary, color: :primary, size: :sm, type: :button, data: {action: "tour#finish", tour_target: "done"}) { "Done" } %>
      </div>

      <div class="tour__actions" data-tour-target="paused" hidden>
        <%= a_button(style: :primary, color: :primary, size: :sm, type: :button, data: {action: "tour#resume"}) { "Continue" } %>
        <%= a_button(style: :text, size: :sm, type: :button, data: {action: "tour#end"}) { "End tour" } %>
      </div>
    </div>
  </div>
</aside>
