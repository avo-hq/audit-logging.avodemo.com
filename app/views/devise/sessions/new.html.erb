<%# The demo's front door. A visitor gives a name and gets an account of their own (User.visitor): nobody signs
    in with an email here. Only classes the Tailwind build already holds. %>
<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <img class="mx-auto h-12 w-auto" src="/img/logo.png" alt="Avo">
    <h2 class="mt-6 text-center text-3xl leading-9 font-extrabold text-gray-900">
      Welcome to Stockroom
    </h2>
    <p class="mt-4 px-4 text-center text-sm leading-5 text-gray-500">
      A warehouse app with Avo on top. Tell us your name and look around.
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
      <% if params[:nameless] %>
        <%# Start the demo was pressed with no name: one is picked, and the visitor takes it or goes back to type theirs. %>
        <% name = "#{Faker::Name.first_name} #{Faker::Name.last_name}" %>
        <%= form_with url: visitor_path do |f| %>
          <%= f.hidden_field :name, value: name %>
          <p class="text-sm leading-5 text-gray-700">
            You didn't give a name, so we'll call you <span class="font-medium text-gray-900"><%= name %></span>.
          </p>

          <div class="mt-6">
            <%= f.button "Start as #{name}", class: "w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-500 focus:outline-none focus:border-indigo-700 focus:shadow-outline-indigo active:bg-indigo-700 transition duration-150 ease-in-out" %>
          </div>
        <% end %>

        <div class="mt-6 text-center text-sm leading-5">
          <%= link_to "I'll type my own name", new_user_session_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
        </div>
      <% else %>
        <%= form_with url: visitor_path do |f| %>
          <%= f.label :name, "Your name", class: "block text-sm font-medium leading-5 text-gray-700" %>
          <div class="mt-1 rounded-md shadow-sm">
            <%= f.text_field :name, maxlength: 30, autofocus: true, autocomplete: "given-name", class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:shadow-outline-blue focus:border-blue-300 transition duration-150 ease-in-out sm:text-sm sm:leading-5" %>
          </div>
          <p class="mt-1 text-sm leading-5 text-gray-500">
            You get an account of your own, so the audit log can tell what you did.
          </p>

          <div class="mt-6">
            <%= f.button "Start the demo", class: "w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-500 focus:outline-none focus:border-indigo-700 focus:shadow-outline-indigo active:bg-indigo-700 transition duration-150 ease-in-out" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="mt-4 text-center">
    Check out the source code on <a href="https://github.com/avo-hq/audit_logging.avodemo.com" target="_blank" class="text-indigo-600">GitHub</a>.
  </div>
</div>
